@model PartnerListViewModel
@{
    var pager = new PagerViewModel
    {
        Controller = "Partners", Action = "Index", Page = Model.Result.Page, Pages = Model.Result.Pages,
        Query = new Dictionary<string, string?> { ["q"] = Model.Q, ["kind"] = Model.Kind, ["sort"] = Model.Sort }
    };
}
<div class="page container">
    <div class="section-head" style="margin-top:0">
        <h1>Partners</h1>
        <p>Tally partners, accountants and service providers who help distributors get live fast.</p>
    </div>

    <form method="get" asp-controller="Partners" asp-action="Index" class="toolbar" role="search">
        <label class="sr-only" for="p-q">Search partners</label>
        <input class="input grow" id="p-q" name="q" value="@Model.Q" placeholder="Search by name, city or service…" maxlength="60">
        <label class="sr-only" for="p-kind">Partner type</label>
        <select class="input" id="p-kind" name="kind" data-autosubmit>
            <option value="">All types</option>
            @foreach (var k in Model.Kinds)
            {
                <option value="@k" selected="@(k == Model.Kind)">@k</option>
            }
        </select>
        <label class="sr-only" for="p-sort">Sort by</label>
        <select class="input" id="p-sort" name="sort" data-autosubmit>
            <option value="name" selected="@(Model.Sort == "name")">Sort: Featured</option>
            <option value="city" selected="@(Model.Sort == "city")">Sort: City</option>
            <option value="kind" selected="@(Model.Sort == "kind")">Sort: Type</option>
        </select>
        <button class="btn" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Q) || !string.IsNullOrWhiteSpace(Model.Kind))
        {
            <a class="btn btn-outline" asp-action="Index">Clear</a>
        }
    </form>
    <p class="muted" role="status">@Model.Result.Total partner@(Model.Result.Total == 1 ? "" : "s") found</p>

    @if (Model.Result.Items.Count == 0)
    {
        <div class="empty"><span class="big" aria-hidden="true">🤝</span><p>No partners match your search.</p></div>
    }
    else
    {
        <div class="grid grid-3">
            @foreach (var p in Model.Result.Items)
            {
                <article class="card">
                    <span class="badge">@p.Kind</span>
                    <h2 style="font-size:1.1rem;margin-top:10px">@p.Name</h2>
                    <p class="muted">@p.Blurb</p>
                    <small class="muted">📍 @p.City</small>
                </article>
            }
        </div>
        <partial name="_Pager" model="pager" />
    }
<button class="mb-trigger-btn" onclick="MeetingBooking.open()">
    Book a meeting with the founder →
</button>
    <form class="card auth-wrap" id="apply" method="post" asp-controller="Partners" asp-action="Apply" novalidate style="max-width:560px;margin-top:40px">
        <h2>Become a partner</h2>
        <div asp-validation-summary="ModelOnly" class="err-list"></div>
        <div class="field">
            <label asp-for="Apply.Name"></label>
            <input asp-for="Apply.Name" autocomplete="organization" />
            <span asp-validation-for="Apply.Name" class="err"></span>
        </div>
        <div class="field">
            <label asp-for="Apply.Email"></label>
            <input asp-for="Apply.Email" type="email" autocomplete="email" />
            <span asp-validation-for="Apply.Email" class="err"></span>
        </div>
        <div class="field">
            <label asp-for="Apply.Phone"></label>
            <input asp-for="Apply.Phone" type="tel" maxlength="10" inputmode="numeric" autocomplete="tel-national" />
            <span asp-validation-for="Apply.Phone" class="err"></span>
        </div>
        <div class="field">
            <label asp-for="Apply.City"></label>
            <input asp-for="Apply.City" autocomplete="address-level2" />
            <span asp-validation-for="Apply.City" class="err"></span>
        </div>
        <button class="btn btn-block" type="submit">Apply</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!ViewContext.ModelState.IsValid)
    {
        <script>document.getElementById('apply').scrollIntoView({ block: 'center' });</script>
    }
}
