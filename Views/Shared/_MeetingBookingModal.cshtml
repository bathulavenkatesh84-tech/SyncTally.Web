@*
    Partial View: _MeetingBookingModal.cshtml
    Place in: Views/Shared/_MeetingBookingModal.cshtml

    Usage - add this anywhere in your layout or page view:
        @await Html.PartialAsync("_MeetingBookingModal")

    Trigger the modal with:
        <button onclick="MeetingBooking.open()">Book a meeting with the founder</button>

    NOTE: CSS and JS are loaded by _Layout.cshtml — do NOT add them here again.
*@
<!-- ===== MEETING BOOKING MODAL ===== -->
<div id="meetingBookingOverlay" class="mb-overlay" role="dialog" aria-modal="true" aria-label="Book a meeting" style="display:none;">
    <div class="mb-modal">

        <!-- CLOSE BUTTON -->
        <button class="mb-close" onclick="MeetingBooking.close()" aria-label="Close">&times;</button>

        <!-- ── STEP 1: Phone Number ── -->
        <div id="mb-step1" class="mb-step">
            <div class="mb-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#3B6CF8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.22 1.22 2 2 0 012.21 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
                </svg>
            </div>
            <h2 class="mb-title">Talk to the founder</h2>
            <p class="mb-subtitle">Drop your number. The next screen books a 15-minute slot.</p>

            <div class="mb-form-group">
                <label class="mb-label" for="mb-phone">Phone Number</label>
                <div class="mb-phone-row">
                    <span class="mb-country-code">+91</span>
                    <input type="tel"
                           id="mb-phone"
                           class="mb-input"
                           placeholder="9876543210"
                           maxlength="10"
                           pattern="[0-9]{10}"
                           inputmode="numeric"
                           autocomplete="tel-national" />
                </div>
                <span id="mb-phone-error" class="mb-error" style="display:none;">Please enter a valid 10-digit mobile number.</span>
            </div>

            <p class="mb-privacy">We will use this number to contact you about the meeting. <a href="/privacy-policy" target="_blank">Privacy policy</a></p>

            <button class="mb-btn-primary" onclick="MeetingBooking.continueToCalendar()">
                Continue to calendar &nbsp;→
            </button>
            <button class="mb-btn-ghost" onclick="MeetingBooking.close()">Cancel</button>
        </div>

        <!-- ── STEP 2: Calendar ── -->
        <div id="mb-step2" class="mb-step" style="display:none;">
            <div class="mb-cal-layout">

                <!-- LEFT PANEL: meeting info -->
                <div class="mb-cal-info">
                    <div class="mb-organizer-row">
                        <div class="mb-avatar" aria-hidden="true">F</div>
                        <div>
                            <div class="mb-organizer-name" id="mb-organizer-name">Founder</div>
                            <div class="mb-organizer-role">Organizer</div>
                        </div>
                    </div>
                    <div class="mb-meta-row">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        <span>15 min</span>
                    </div>
                    <div class="mb-meta-row">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>
                        <span>Google Meet</span>
                    </div>
                    <div class="mb-meta-sub">Details provided upon confirmation</div>
                </div>

                <!-- RIGHT PANEL: calendar + time picker -->
                <div class="mb-cal-right">
                    <h3 class="mb-cal-heading">Pick a date and time</h3>

                    <!-- Month navigation -->
                    <div class="mb-month-nav">
                        <button class="mb-nav-btn" onclick="MeetingBooking.prevMonth()" aria-label="Previous month">&#8249;</button>
                        <span id="mb-month-label" class="mb-month-label"></span>
                        <button class="mb-nav-btn" onclick="MeetingBooking.nextMonth()" aria-label="Next month">&#8250;</button>
                    </div>

                    <!-- Day-of-week headers -->
                    <div class="mb-day-headers">
                        <span>Su</span><span>Mo</span><span>Tu</span><span>We</span>
                        <span>Th</span><span>Fr</span><span>Sa</span>
                    </div>

                    <!-- Calendar grid -->
                    <div id="mb-calendar-grid" class="mb-calendar-grid"></div>

                    <!-- Timezone -->
                    <div class="mb-tz-row">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20" /></svg>
                        <span id="mb-tz-label">GMT+5:30 Calcutta</span>
                    </div>
                </div>
            </div>

            <!-- Time slots panel (shows after date selection) -->
            <div id="mb-time-panel" class="mb-time-panel" style="display:none;">
                <div class="mb-time-header" id="mb-time-date-label"></div>
                <div id="mb-time-slots" class="mb-time-slots"></div>
            </div>
        </div>

        <!-- ── STEP 3: Confirm details ── -->
        <div id="mb-step3" class="mb-step" style="display:none;">
            <div class="mb-icon mb-icon-success">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
            <h2 class="mb-title">Confirm your booking</h2>
            <div class="mb-summary">
                <div class="mb-summary-row">
                    <span class="mb-summary-label">Date &amp; Time</span>
                    <span id="mb-confirm-datetime" class="mb-summary-value"></span>
                </div>
                <div class="mb-summary-row">
                    <span class="mb-summary-label">Duration</span>
                    <span class="mb-summary-value">15 minutes</span>
                </div>
                <div class="mb-summary-row">
                    <span class="mb-summary-label">Phone</span>
                    <span id="mb-confirm-phone" class="mb-summary-value"></span>
                </div>
                <div class="mb-summary-row">
                    <span class="mb-summary-label">Platform</span>
                    <span class="mb-summary-value">Google Meet</span>
                </div>
            </div>

            <div class="mb-form-group" style="margin-top:16px;">
                <label class="mb-label" for="mb-name">Your Name</label>
                <input type="text" id="mb-name" class="mb-input" placeholder="Your full name" autocomplete="name" />
            </div>
            <div class="mb-form-group">
                <label class="mb-label" for="mb-email">Email (for Google Meet link)</label>
                <input type="email" id="mb-email" class="mb-input" placeholder="you@company.com" autocomplete="email" />
                <span id="mb-email-error" class="mb-error" style="display:none;">Please enter a valid email address.</span>
            </div>

            <button class="mb-btn-primary" onclick="MeetingBooking.submitBooking()">
                <span id="mb-submit-text">Confirm booking</span>
                <span id="mb-submit-loader" style="display:none;">Booking…</span>
            </button>
            <button class="mb-btn-ghost" onclick="MeetingBooking.goToStep(2)">← Change time</button>
        </div>

        <!-- ── STEP 4: Booked! ── -->
        <div id="mb-step4" class="mb-step" style="display:none;">
            <div class="mb-icon mb-icon-success">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="9 12 11 14 15 10" />
                </svg>
            </div>
            <h2 class="mb-title">You're booked!</h2>
            <p class="mb-subtitle">A Google Meet invite has been sent to your email. We'll also WhatsApp you a reminder before the call.</p>
            <div id="mb-meet-link-box" class="mb-meet-link-box" style="display:none;">
                <span class="mb-meet-label">Your Google Meet link</span>
                <a id="mb-meet-link" href="#" target="_blank" class="mb-meet-url"></a>
            </div>
            <div class="mb-confirmed-details">
                <div class="mb-summary-row">
                    <span class="mb-summary-label">When</span>
                    <span id="mb-done-datetime" class="mb-summary-value"></span>
                </div>
            </div>
            <button class="mb-btn-primary" onclick="MeetingBooking.close()">Done</button>
        </div>

    </div>
</div>
